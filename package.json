{
  "name": "goalpost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An on-chain audit for silently moved goalposts. A GenLayer Intelligent Contract for Studionet with a static web console.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -t tests -v",
    "lint:contract": "genvm-lint check contracts/goalpost.py",
    "deploy:contract": "node scripts/deploy.mjs",
    "e2e": "node scripts/e2e.mjs",
    "evidence": "node scripts/evidence.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
