# Address of the deployed Goalpost contract on Studionet (printed by `npm run deploy:contract`). Set to the live deployment; see evidence/.
VITE_CONTRACT_ADDRESS=0xe0167DeFD7b55bd4C120092Ee340078077186c3f

# GenLayer Studionet JSON-RPC. Use "/rpc" to read through the optional Cloudflare proxy in functions/rpc.ts.
VITE_RPC_URL=https://studio.genlayer.com/api

# Block explorer used for transaction and address links.
VITE_EXPLORER_URL=https://explorer-studio.genlayer.com
